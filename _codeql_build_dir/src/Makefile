vm/vm.cpp.s:
	cd /home/runner/work/bloop-lang/bloop-lang/_codeql_build_dir && $(MAKE) $(MAKESILENT) -f src/CMakeFiles/bloop.dir/build.make src/CMakeFiles/bloop.dir/vm/vm.cpp.s
.PHONY : vm/vm.cpp.s

