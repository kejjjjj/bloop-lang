let a = 0;
let b = 0;
let c = 0;
a = b = c = 5;

let arr = [0, 0];
let obj = { x: 0 };
arr[0] = obj.x = arr[1] = 7;

let d = 1;
d += a = 2;      // a = 2, d = 3

let e = 10;
e = d -= 1;      // d = 2, e = 2

let captured = 0;
const f = () => {
    let local = 0;
    captured = local = 9;
    return local;
};

return [a, b, c, arr[0], arr[1], obj.x, d, e, f(), captured, 20 - 5 - 3];
