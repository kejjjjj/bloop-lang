fn binarySearch(arr, target, lo, hi) {
    if (lo > hi)
        return -1;

    let mid = lo + (hi - lo) / 2;

    if (arr[mid] == target)
        return mid;

    if (arr[mid] < target)
        return binarySearch(arr, target, mid + 1, hi);

    return binarySearch(arr, target, lo, mid - 1);
}

let arr = [1, 3, 5, 7, 9, 11];
return binarySearch(arr, 7, 0, 5);
