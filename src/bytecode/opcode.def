BLOOP_OP(MAKE_FUNCTION)

// BLOOP_OP(DEFINE_GLOBAL)

BLOOP_OP(LOAD_CONST)
BLOOP_OP(LOAD_LOCAL)
BLOOP_OP(LOAD_UPVALUE)
BLOOP_OP(LOAD_GLOBAL)

BLOOP_OP(CREATE_ARRAY)
BLOOP_OP(CREATE_OBJECT)

BLOOP_OP(STORE_LOCAL)
BLOOP_OP(STORE_GLOBAL)
BLOOP_OP(STORE_UPVALUE)

BLOOP_OP(ADD)
BLOOP_OP(SUB)
BLOOP_OP(MUL)
BLOOP_OP(DIV)
BLOOP_OP(MOD)
BLOOP_OP(LESS_EQUAL)
BLOOP_OP(LESS)
BLOOP_OP(GREATER_EQUAL)
BLOOP_OP(GREATER)
BLOOP_OP(LOGICAL_OR)
BLOOP_OP(LOGICAL_AND)

BLOOP_OP(LEFT_SHIFT)
BLOOP_OP(RIGHT_SHIFT)

BLOOP_OP(BITWISE_OR)
BLOOP_OP(BITWISE_AND)
BLOOP_OP(BITWISE_XOR)

BLOOP_OP(SEQUENCE)

BLOOP_OP(EQ)
BLOOP_OP(S_EQ)
BLOOP_OP(NE)
BLOOP_OP(S_NE)

BLOOP_OP(RETURN)
BLOOP_OP(RETURN_VALUE)

BLOOP_OP(JMP)
BLOOP_OP(JZ)

BLOOP_OP(CALL)
BLOOP_OP(SUBSCRIPT_GET)
BLOOP_OP(SUBSCRIPT_SET)
BLOOP_OP(PROPERTY_GET)
BLOOP_OP(PROPERTY_SET)
BLOOP_OP(MAKE_CLOSURE)
BLOOP_OP(CAPTURE_LOCAL)
BLOOP_OP(CAPTURE_UPVALUE)
BLOOP_OP(CAPTURE_GLOBAL) // (only after MAKE_CLOSURE) slot: a new closed upvalue with the global's current value

BLOOP_OP(POP)

BLOOP_OP(DUP)
BLOOP_OP(INCR)
BLOOP_OP(DECR)
BLOOP_OP(NEG)
BLOOP_OP(NOT) // [value] -> [!value] (a boolean)
BLOOP_OP(BITWISE_NOT) // [value] -> [~value] (integers)
BLOOP_OP(CONCAT) // count: [v1 ... vn] -> [one string of them all] (template strings: values become strings like std.string.from)

BLOOP_OP(TRY) //catch_ip, base, catch_var
BLOOP_OP(TRY_END)
BLOOP_OP(THROW)

// ranged for: for (const x : iterable)
BLOOP_OP(ITER_PREPARE) // [iterable] -> [iterable, index]: checks that the value is iterable
BLOOP_OP(ITER_NEXT) // target: [iterable, index] -> [iterable, index + 1, element], or jumps to target when done
BLOOP_OP(CLOSE_UPVALUES) // slot: closes the upvalues of this frame's locals from slot upwards
